{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "tail_turns": 15
  },
  "provider": {
    "deepseek": {
      "models": {
        "deepseek-chat": {
          "limit": {
            "context": 150000,
            "output": 8192
          }
        }
      }
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp", "--browser=msedge", "--allow-unrestricted-file-access"],
      "enabled": true,
      "env": { "ALLOW_UNRESTRICTED_FILE_ACCESS": "true" }
    }
  }
}
